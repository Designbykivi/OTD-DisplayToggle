<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>DisplayToggle</AssemblyName>
    <RootNamespace>DisplayToggle</RootNamespace>
    <Version>1.0.0.0</Version>
    <Authors>Designbykivi</Authors>
    <Description>Switch the tablet's mapped monitor with a pen button or express key.</Description>
    <Copyright>Copyright (c) 2026 Designbykivi</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Designbykivi/OTD-DisplayToggle</RepositoryUrl>
    <!-- OTD loads plugins as a single DLL; the host provides OpenTabletDriver.Plugin itself. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.6.5.1 is the oldest net8.0 build of the plugin API; works on OTD 0.6.5 and newer. -->
    <PackageReference Include="OpenTabletDriver.Plugin" Version="0.6.5.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
